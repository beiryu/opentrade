# OpenTrade reads these from the environment (or a .env file you keep local).
# Never commit a real key. .env is gitignored.

# OpenAI-compatible endpoint. Default: Vercel AI Gateway (one key, any model).
# Any OpenAI-compatible server works: DeepSeek, OpenAI, Ollama, LM Studio...
OPENTRADE_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENTRADE_LLM_API_KEY=
OPENTRADE_LLM_MODEL=deepseek/deepseek-v4.1-flash

# SQLite database file (created on first run)
OPENTRADE_DB=data/local/opentrade.db

# Where daily OHLCV CSVs live (one file per symbol, VNINDEX.csv for the index)
OPENTRADE_DATA_DIR=data/sample

# HTTP server bind address (local only by default)
OPENTRADE_LISTEN=127.0.0.1:8080

# Paper account
OPENTRADE_INITIAL_CASH=100000000
OPENTRADE_UNIVERSE=FPT,VNM,VCB,HPG,MWG,VIC,VHM,GAS,MSN,TCB
